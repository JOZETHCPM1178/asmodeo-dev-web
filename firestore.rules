// firestore.rules
// ════════════════════════════════════════
//  FIRESTORE SECURITY RULES v2
//  Copia en: Firebase Console → Firestore → Rules → Publicar
// ════════════════════════════════════════

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPERS ───
    function isAuth() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function isOwner(userId) {
      return isAuth() && uid() == userId;
    }
    // Leer rol sin causar bucles infinitos
    function userRole() {
      return get(/databases/$(database)/documents/users/$(uid())).data.get('role', 'user');
    }
    function isAdmin() {
      return isAuth() && userRole() == 'admin';
    }
    function isStaff() {
      return isAuth() && userRole() in ['admin', 'admin_jr'];
    }
    function notBanned() {
      return isAuth() && get(/databases/$(database)/documents/users/$(uid())).data.get('banned', false) == false;
    }

    // ─── USERS ───
    // Crear perfil al registrarse: cualquier usuario autenticado puede crear SU perfil
    match /users/{userId} {
      allow read: if true;
      // Crear: el usuario solo puede crear su propio documento
      allow create: if isOwner(userId);
      // Actualizar: el propio usuario o un admin
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── POSTS ───
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuth() && notBanned();
      // Actualizar: staff o el propio autor (no puede cambiar likes/downloads/status)
      allow update: if isStaff() || (
        isAuth() &&
        resource.data.authorId == uid() &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['likes', 'downloads', 'views', 'status', 'featured', 'verified', 'score'])
      );
      allow delete: if isStaff() || (isAuth() && resource.data.authorId == uid());

      // Likes
      match /likes/{likeUserId} {
        allow read: if true;
        allow write: if isOwner(likeUserId);
      }

      // Comentarios
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuth() && notBanned()
          && request.resource.data.userId == uid()
          && request.resource.data.text.size() <= 500;
        allow delete: if isStaff() || (isAuth() && resource.data.userId == uid());
        allow update: if false;
      }
    }

    // ─── FOLLOWS ───
    match /follows/{followId} {
      allow read: if true;
      allow create: if isAuth() && notBanned()
        && request.resource.data.followerId == uid();
      allow delete: if isAuth() && resource.data.followerId == uid();
    }

    // ─── NOTIFICACIONES ───
    match /notifications/{notifId} {
      allow read: if isAuth() && resource.data.userId == uid();
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.userId == uid();
      allow delete: if isAuth() && resource.data.userId == uid();
    }

    // ─── CHAT GLOBAL ───
    match /globalChat/{msgId} {
      allow read: if true;
      allow create: if isAuth() && notBanned()
        && request.resource.data.userId == uid()
        && request.resource.data.text.size() <= 300;
      allow delete: if isStaff() || (isAuth() && resource.data.userId == uid());
      allow update: if false;
    }

    // ─── REPORTES ───
    match /reports/{reportId} {
      allow read: if isStaff();
      allow create: if isAuth();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // ─── CONFIG (estado del chat, etc.) ───
    match /config/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ─── ADMIN LOGS ───
    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isStaff();
      allow update, delete: if false;
    }
  }
}
