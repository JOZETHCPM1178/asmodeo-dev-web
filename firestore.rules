// firestore.rules — v6 (fixed)
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }
    function myUid() { return request.auth.uid; }
    function myData() {
      return get(/databases/$(database)/documents/users/$(myUid())).data;
    }
    function myRole() {
      return isAuth() ? myData().get('role', 'user') : 'guest';
    }
    function isOwner()   { return isAuth() && myRole() == 'owner'; }
    function isAdmin()   { return isAuth() && (myRole() == 'admin' || myRole() == 'owner'); }
    function isAdminJr() { return isAuth() && myRole() == 'admin_jr'; }
    function isStaff()   { return isOwner() || isAdmin() || isAdminJr(); }
    function notBanned() { return isAuth() && myData().get('banned', false) == false; }

    // USUARIOS
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuth() && myUid() == userId;
      allow update: if isAuth() && (
        myUid() == userId ||
        (isAdmin() && resource.data.role != 'owner')
      );
      allow delete: if isAdmin();
    }

    // POSTS
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuth() && notBanned();
      allow update: if isStaff() || (
        isAuth() && notBanned() &&
        resource.data.authorId == myUid() &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['likes','downloads','views','status','featured','verified','score'])
      );
      allow delete: if isStaff() || (isAuth() && resource.data.authorId == myUid());

      match /likes/{likeUserId} {
        allow read: if true;
        allow create: if isAuth() && notBanned() && myUid() == likeUserId;
        allow delete: if isAuth() && myUid() == likeUserId;
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isStaff() || (
          isAuth() && notBanned()
          && request.resource.data.userId == myUid()
          && request.resource.data.text.size() <= 500
        );
        allow delete: if isStaff() || (isAuth() && resource.data.userId == myUid());
        allow update: if false;
      }
    }

    // FOLLOWS
    match /follows/{followId} {
      allow read: if true;
      allow create: if isAuth() && notBanned()
        && request.resource.data.followerId == myUid();
      allow delete: if isAuth() && resource.data.followerId == myUid();
      allow update: if false;
    }

    // NOTIFICACIONES
    match /notifications/{notifId} {
      allow read: if isAuth() && resource.data.userId == myUid();
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.userId == myUid();
      allow delete: if isAuth() && resource.data.userId == myUid();
    }

    // CHAT GLOBAL
    match /globalChat/{msgId} {
      allow read: if true;
      allow create: if isAuth() && notBanned()
        && request.resource.data.userId == myUid()
        && request.resource.data.text.size() <= 300;
      allow delete: if isStaff() || (isAuth() && resource.data.userId == myUid());
      allow update: if false;
    }

    // REPORTES
    match /reports/{reportId} {
      allow read: if isStaff();
      allow create: if isAuth();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // CONFIG
    match /config/{docId} {
      allow read: if true;
      allow write: if isOwner() || isAdmin();
    }

    // LOGS DE ADMIN
    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    // MENSAJES PRIVADOS (DMs)
    // FIX: verificar participación tanto por convId como por resource.data.participants
    match /conversations/{convId} {
      allow read: if isAuth() && (
        convId.matches('.*' + myUid() + '.*') ||
        myUid() in resource.data.participants
      );
      allow create: if isAuth() && notBanned()
        && myUid() in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update: if isAuth() && (
        convId.matches('.*' + myUid() + '.*') ||
        myUid() in resource.data.participants
      );
      allow delete: if false;

      match /messages/{msgId} {
        allow read: if isAuth() && convId.matches('.*' + myUid() + '.*');
        allow create: if isAuth() && notBanned()
          && request.resource.data.senderId == myUid()
          && convId.matches('.*' + myUid() + '.*');
        allow update, delete: if false;
      }
    }

    // CÓDIGOS DE LOGIN TELEGRAM
    match /loginCodes/{code} {
      allow read, write: if true;
    }

    // RECOMPENSAS DIARIAS
    match /rewards/{rewardId} {
      allow read, write: if true;
    }
  }
}
